# Environment — development or production
SOCKETCAST_ENV=development

# Logging — debug, info, warning, error, critical
SOCKETCAST_LOG_LEVEL=info

# Redis configuration
REDIS_URL=redis://localhost:6379/0

# Engine configuration
ENGINE_HOST=localhost
ENGINE_CONTROL_PORT=5001

# Mock metrics for testing/demo (disable in production)
SOCKETCAST_MOCK_METRICS=false

# CORS allowed origins (comma-separated, use * for all in dev)
ALLOWED_ORIGINS=*

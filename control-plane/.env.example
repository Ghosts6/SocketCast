# Copy to .env and adjust for local dev.
SOCKETCAST_ENV=development
SOCKETCAST_LOG_LEVEL=info

REDIS_URL=redis://redis:6379/0

# Address of the C++ transport engine (control channel — TODO once
# the pybind11/IPC boundary from Doc/dev/04-architecture-and-tech-decisions.md
# is decided).
ENGINE_HOST=engine
ENGINE_CONTROL_PORT=5001
